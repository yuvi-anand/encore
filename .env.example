EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

EXPO_PUBLIC_SPOTIFY_CLIENT_ID=your-spotify-client-id
EXPO_PUBLIC_SPOTIFY_REDIRECT_URI=encore://auth/spotify

EXPO_PUBLIC_BANDSINTOWN_APP_ID=your-bandsintown-app-id

EXPO_PUBLIC_TICKETMASTER_API_KEY=your-ticketmaster-api-key

EXPO_PUBLIC_APPLE_MUSIC_DEVELOPER_TOKEN=your-apple-music-token

# Last.fm — create a free API account at https://www.last.fm/api/account/create
# with callback URL encore://auth/lastfm. The API key ships in the app; the
# shared secret must NOT — it lives only in Supabase function secrets
# (LASTFM_API_KEY / LASTFM_API_SECRET), used by the lastfm-auth edge function.
EXPO_PUBLIC_LASTFM_API_KEY=your-lastfm-api-key
